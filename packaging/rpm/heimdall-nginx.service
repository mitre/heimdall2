[Unit]
Description=Heimdall Nginx HTTPS proxy
After=network-online.target heimdall-server.service
Wants=network-online.target

[Service]
Type=simple
User=heimdall-nginx
Group=heimdall-nginx
StateDirectory=heimdall-nginx
StateDirectoryMode=0700
RuntimeDirectory=heimdall-nginx
RuntimeDirectoryMode=0750
ExecStartPre=/usr/libexec/heimdall-server/runtime/nginx/sbin/nginx -t -c /etc/heimdall-server/nginx/nginx.conf
ExecStart=/usr/libexec/heimdall-server/runtime/nginx/sbin/nginx -c /etc/heimdall-server/nginx/nginx.conf -g "daemon off;"
ExecReload=/usr/libexec/heimdall-server/runtime/nginx/sbin/nginx -t -c /etc/heimdall-server/nginx/nginx.conf
ExecReload=/bin/kill -s HUP $MAINPID
KillSignal=SIGQUIT
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/heimdall-nginx /run/heimdall-nginx
UMask=0077

[Install]
WantedBy=multi-user.target
