# syntax=docker/dockerfile:1
FROM golang:1.25.8 AS go-toolchain
FROM oraclelinux:8 AS trusted-base
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN --mount=type=secret,id=corp_ca \
    if [[ -s /run/secrets/corp_ca ]]; then \
      install -m 0644 /run/secrets/corp_ca /etc/pki/ca-trust/source/anchors/rpm-test-ca.crt; \
      update-ca-trust; \
    fi
ENV NODE_EXTRA_CA_CERTS=/etc/pki/tls/certs/ca-bundle.crt

FROM trusted-base AS test-host
RUN mkdir -p /usr/share/man/man1 && \
    dnf install -y systemd procps-ng && dnf clean all
CMD ["/sbin/init"]

FROM trusted-base AS build-env
COPY --from=go-toolchain /usr/local/go /usr/local/go
ENV PATH=/usr/local/go/bin:$PATH
ENV GOTOOLCHAIN=local
ARG HEIMDALL_RELEASE=0.1.integration
# Optional workaround for x86_64 V8 address-space collisions under QEMU.
ARG QEMU_GUEST_BASE
WORKDIR /workspace
COPY . .
RUN bash packaging/rpm/scripts/setup-build-deps.sh --skip-update

FROM build-env AS builder
# Optional limits for builders with less memory than their CPU count suggests.
ARG NODE_OPTIONS=""
ARG VUE_BUILD_WORKERS=""
RUN set -eu; \
    if [[ -n "$VUE_BUILD_WORKERS" ]]; then \
      if ! [[ "$VUE_BUILD_WORKERS" =~ ^[1-9][0-9]*$ ]]; then \
        echo 'VUE_BUILD_WORKERS must be a positive integer' >&2; exit 2; \
      fi; \
      vue_config_dir="$(mktemp -d)"; \
      trap 'rm -rf "$vue_config_dir"' EXIT; \
      printf '%s\n' '{"type":"commonjs"}' > "$vue_config_dir/package.json"; \
      printf '%s\n' \
        "module.exports = { ...require(process.cwd() + '/vue.config.js'), parallel: Number(process.env.VUE_BUILD_WORKERS) };" \
        > "$vue_config_dir/config.cjs"; \
      export VUE_CLI_SERVICE_CONFIG_PATH="$vue_config_dir/config.cjs"; \
    fi; \
    make -C packaging/rpm rpm SOURCE_MODE=workspace TOPDIR=/rpmbuild \
      HEIMDALL_RELEASE="$HEIMDALL_RELEASE" && \
    bash packaging/rpm/tests/cli-inputs.sh /rpmbuild && \
    bash packaging/rpm/tests/payload.sh \
      /rpmbuild/RPMS/$(rpm -E '%{_arch}')/heimdall-server-*.rpm 2.13.1

FROM scratch AS artifacts
COPY --from=builder /rpmbuild/RPMS /RPMS
COPY --from=builder /rpmbuild/SRPMS /SRPMS
COPY --from=builder /rpmbuild/SOURCES/runtime-manifest.json /runtime-manifest.json
