{
  "name": "inspecjs",
  "version": "2.13.0",
  "license": "Apache-2.0",
  "description": "Schema definitions, classes on top, and utilities to deal with HDF files",
  "keywords": [
    "inspec",
    "hdf",
    "ohdf",
    "heimdall",
    "security",
    "compliance",
    "mitre-saf"
  ],
  "homepage": "https://github.com/mitre/heimdall2#readme",
  "bugs": "https://github.com/mitre/heimdall2/issues",
  "author": "MITRE Corporation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mitre/heimdall2.git",
    "directory": "libs/inspecjs"
  },
  "files": [
    "lib"
  ],
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc -p ./tsconfig.build.json",
    "lint": "eslint --fix",
    "lint:ci": "eslint --max-warnings 0",
    "prepack": "yarn build && cp package.json package.json.orig && cat package.json.orig | jq '.main = \"lib/index.js\"' > package.json",
    "postpack": "mv package.json.orig package.json",
    "test": "vitest",
    "test:ci": "vitest run",
    "gen-types": "bash scripts/update_schema.sh",
    "validate-types": "git diff --exit-code HEAD -- schemas/ src/generated_parsers/"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "quicktype": "^15.0.260",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
