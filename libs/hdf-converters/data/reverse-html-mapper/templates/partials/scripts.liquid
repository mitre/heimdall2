{% comment %}Inline JavaScript for interactive features (~120 lines).
Runs after DOM is ready (placed at end of <body> by html.liquid).
Degrades gracefully — all controls visible if JS is blocked.{% endcomment -%}
(function() {
  var h = document.documentElement;
  var controls = [].slice.call(document.querySelectorAll('article.control'));
  var total = controls.length;
  var activeStatus = {}, activeSeverity = {}, activeFamilies = {};
  var countEl = document.getElementById('filter-count');
  var tokensEl = document.getElementById('active-tokens');
  var clearBtn = document.getElementById('btn-clear-filters');
  var searchInput = document.getElementById('control-search');
  var familyDetails = document.getElementById('nist-family-filter');
  var familyTrigger = document.getElementById('nist-family-trigger');
  var familyList = document.getElementById('nist-family-list');
  var debounceTimer;
  var searchTerms = [];

  function parseQuery(q) {
    var terms = [];
    var re = /"([^"]+)"/g, m;
    while ((m = re.exec(q)) !== null) terms.push(m[1].toLowerCase());
    var rest = q.replace(/"[^"]*"/g, '').trim().toLowerCase();
    if (rest) {
      rest.split(/\s+/).forEach(function(t) { if (t) terms.push(t); });
    }
    return terms;
  }

  function applyFilters() {
    var visible = 0;
    var hasStatus = Object.keys(activeStatus).length > 0;
    var hasSeverity = Object.keys(activeSeverity).length > 0;
    var hasFamily = Object.keys(activeFamilies).length > 0;
    var allSearch = searchTerms.concat(searchInput ? parseQuery(searchInput.value) : []);
    for (var i = 0; i < controls.length; i++) {
      var c = controls[i];
      var st = c.getAttribute('data-status');
      var sv = (c.getAttribute('data-severity') || '').toLowerCase();
      var show = true;
      if (hasStatus && !activeStatus[st]) show = false;
      if (show && hasSeverity && !activeSeverity[sv]) show = false;
      if (show && hasFamily) {
        var fams = (c.getAttribute('data-families') || '').split(',');
        var match = false;
        for (var j = 0; j < fams.length; j++) { if (activeFamilies[fams[j]]) { match = true; break; } }
        if (!match) show = false;
      }
      if (show && allSearch.length) {
        var s = c.dataset.search || '';
        for (var ti = 0; ti < allSearch.length; ti++) { if (s.indexOf(allSearch[ti]) === -1) { show = false; break; } }
      }
      c.classList.toggle('filtered-out', !show);
      if (show) visible++;
    }
    var hasAny = hasStatus || hasSeverity || hasFamily || allSearch.length;
    if (countEl) countEl.textContent = hasAny ? visible + ' of ' + total + ' controls' : total + ' controls';
    var countForStatus = {}, countForSeverity = {}, countForFamily = {};
    for (var k = 0; k < controls.length; k++) {
      var ck = controls[k];
      var cst = ck.getAttribute('data-status');
      var csv = (ck.getAttribute('data-severity') || '').toLowerCase();
      var cfams = (ck.getAttribute('data-families') || '').split(',');
      var passSev = !hasSeverity || activeSeverity[csv];
      var passFam = !hasFamily || cfams.some(function(f) { return activeFamilies[f]; });
      var passQ = !allSearch.length || allSearch.every(function(t) { return (ck.dataset.search || '').indexOf(t) !== -1; });
      if (passSev && passFam && passQ) countForStatus[cst] = (countForStatus[cst] || 0) + 1;
      var passSt = !hasStatus || activeStatus[cst];
      if (passSt && passFam && passQ) countForSeverity[csv] = (countForSeverity[csv] || 0) + 1;
      if (passSt && passSev && passQ) { for (var fi = 0; fi < cfams.length; fi++) { if (cfams[fi]) countForFamily[cfams[fi]] = (countForFamily[cfams[fi]] || 0) + 1; } }
    }
    document.querySelectorAll('.chip[data-filter-status] .chip-count').forEach(function(el) { el.textContent = countForStatus[el.parentElement.getAttribute('data-filter-status')] || 0; });
    document.querySelectorAll('.chip[data-filter-severity] .chip-count').forEach(function(el) { el.textContent = countForSeverity[el.parentElement.getAttribute('data-filter-severity')] || 0; });
    document.querySelectorAll('#nist-family-list label').forEach(function(lbl) { var cb = lbl.querySelector('input'); if (cb) { var f = cb.value; lbl.lastChild.textContent = ' ' + f + ' (' + (countForFamily[f] || 0) + ')'; } });
    updateTokens();
    updateFamilyTrigger();
  }

  function updateFamilyTrigger() {
    if (!familyTrigger) return;
    var keys = Object.keys(activeFamilies);
    familyTrigger.textContent = keys.length ? 'NIST (' + keys.length + ')' : 'NIST Family';
  }

  function updateTokens() {
    if (!tokensEl) return;
    var parts = [];
    Object.keys(activeStatus).forEach(function(s) { parts.push('<button class="active-token" data-remove-status="' + s + '">&times; ' + s + '</button>'); });
    Object.keys(activeSeverity).forEach(function(s) { parts.push('<button class="active-token" data-remove-severity="' + s + '">&times; ' + s + '</button>'); });
    Object.keys(activeFamilies).forEach(function(f) { parts.push('<button class="active-token" data-remove-family="' + f + '">&times; ' + f + '</button>'); });
    searchTerms.forEach(function(t) { parts.push('<button class="active-token" data-remove-search="' + t + '">&times; ' + t + '</button>'); });
    tokensEl.innerHTML = parts.join('');
    tokensEl.hidden = parts.length === 0;
    if (clearBtn) clearBtn.hidden = parts.length === 0;
  }

  function toggleChip(btn, map, key) {
    if (map[key]) { delete map[key]; btn.removeAttribute('aria-current'); } else { map[key] = true; btn.setAttribute('aria-current', 'true'); }
    applyFilters();
  }

  document.addEventListener('click', function(e) {
    var t = e.target.closest ? e.target.closest('[data-filter-status]') : null;
    if (t && !t.classList.contains('bar-seg') && !t.classList.contains('active-token')) { toggleChip(t, activeStatus, t.getAttribute('data-filter-status')); return; }
    if (t && t.classList.contains('bar-seg')) {
      var st = t.getAttribute('data-filter-status');
      var chips = document.querySelectorAll('.chip[data-filter-status="' + st + '"]');
      if (chips.length) toggleChip(chips[0], activeStatus, st);
      return;
    }
    var sv = e.target.closest ? e.target.closest('.chip[data-filter-severity]') : null;
    if (sv) { toggleChip(sv, activeSeverity, sv.getAttribute('data-filter-severity')); return; }
    var rs = e.target.closest ? e.target.closest('[data-remove-status]') : null;
    if (rs) { var k = rs.getAttribute('data-remove-status'); delete activeStatus[k]; var c = document.querySelector('.chip[data-filter-status="' + k + '"]'); if (c) c.removeAttribute('aria-current'); applyFilters(); return; }
    var rv = e.target.closest ? e.target.closest('[data-remove-severity]') : null;
    if (rv) { var k2 = rv.getAttribute('data-remove-severity'); delete activeSeverity[k2]; var c2 = document.querySelector('.chip[data-filter-severity="' + k2 + '"]'); if (c2) c2.removeAttribute('aria-current'); applyFilters(); return; }
    var rf = e.target.closest ? e.target.closest('[data-remove-family]') : null;
    if (rf) { var fk = rf.getAttribute('data-remove-family'); delete activeFamilies[fk]; var cb = document.querySelector('#nist-family-list input[value="' + fk + '"]'); if (cb) cb.checked = false; applyFilters(); return; }
    var rq = e.target.closest ? e.target.closest('[data-remove-search]') : null;
    if (rq) { var term = rq.getAttribute('data-remove-search'); searchTerms = searchTerms.filter(function(t) { return t !== term; }); if (searchInput) searchInput.value = searchTerms.map(function(t) { return t.indexOf(' ') !== -1 ? '"' + t + '"' : t; }).join(' '); applyFilters(); return; }
  });

  var committing = false;

  function commitSearch() {
    committing = true;
    var newTerms = parseQuery(searchInput.value);
    if (newTerms.length) {
      newTerms.forEach(function(t) { if (searchTerms.indexOf(t) === -1) searchTerms.push(t); });
      searchInput.value = '';
    }
    committing = false;
    applyFilters();
  }

  if (searchInput) {
    searchInput.addEventListener('input', function() {
      if (committing) return;
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(function() { applyFilters(); }, 200);
    });
    searchInput.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') { e.preventDefault(); clearTimeout(debounceTimer); commitSearch(); }
    });
    searchInput.addEventListener('blur', function() {
      clearTimeout(debounceTimer);
      if (searchInput.value.trim()) commitSearch();
    });
    var searchForm = searchInput.closest('form');
    if (searchForm) searchForm.addEventListener('submit', function(e) { e.preventDefault(); });
  }

  if (familyList) {
    var cbs = familyList.querySelectorAll('input[type="checkbox"]');
    for (var ci = 0; ci < cbs.length; ci++) {
      (function(cb) { cb.addEventListener('change', function() { if (cb.checked) activeFamilies[cb.value] = true; else delete activeFamilies[cb.value]; applyFilters(); }); })(cbs[ci]);
    }
  }

  var profileToggles = document.querySelectorAll('.profile-toggle');
  profileToggles.forEach(function(btn) {
    btn.setAttribute('aria-pressed', 'true');
    btn.addEventListener('click', function() {
      var fid = btn.getAttribute('data-file-id');
      var section = document.getElementById('file-' + fid);
      if (!section) return;
      var visible = btn.getAttribute('aria-pressed') !== 'false';
      btn.setAttribute('aria-pressed', String(!visible));
      section.classList.toggle('filtered-out', visible);
      applyFilters();
    });
  });

  if (clearBtn) clearBtn.addEventListener('click', function() {
    activeStatus = {}; activeSeverity = {}; activeFamilies = {}; searchTerms = [];
    if (searchInput) searchInput.value = '';
    document.querySelectorAll('.chip[aria-current]').forEach(function(c) { c.removeAttribute('aria-current'); });
    document.querySelectorAll('#nist-family-list input').forEach(function(cb) { cb.checked = false; });
    if (familyDetails) familyDetails.open = false;
    profileToggles.forEach(function(btn) { btn.setAttribute('aria-pressed', 'true'); var s = document.getElementById('file-' + btn.getAttribute('data-file-id')); if (s) s.classList.remove('filtered-out'); });
    applyFilters();
  });

  var expandBtn = document.getElementById('btn-expand-all');
  var collapseBtn = document.getElementById('btn-collapse-all');
  if (expandBtn) expandBtn.addEventListener('click', function() { [].slice.call(document.querySelectorAll('#main details')).forEach(function(d) { var parent = d.closest('.filtered-out'); if (!parent) d.open = true; }); });
  if (collapseBtn) collapseBtn.addEventListener('click', function() { [].slice.call(document.querySelectorAll('#main details')).forEach(function(d) { d.open = false; }); });

  var viewBtns = [].slice.call(document.querySelectorAll('[data-view-level]'));
  viewBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      viewBtns.forEach(function(b) { b.removeAttribute('aria-current'); });
      btn.setAttribute('aria-current', 'true');
      h.setAttribute('data-report-level', btn.getAttribute('data-view-level'));
    });
  });

  var printBtn = document.getElementById('btn-print');
  if (printBtn) printBtn.addEventListener('click', function() { window.print(); });

  var themeBtn = document.getElementById('theme-toggle');
  if (themeBtn) themeBtn.addEventListener('click', function() { h.setAttribute('data-theme', h.getAttribute('data-theme') === 'dark' ? 'light' : 'dark'); });

  var filterBar = document.getElementById('filter-bar');
  var filterToggle = document.getElementById('nav-filter-toggle');
  if (filterBar && filterToggle) {
    if (window.innerWidth > 768) filterBar.hidden = false;
    filterToggle.addEventListener('click', function() { var show = filterBar.hidden; filterBar.hidden = !show; filterToggle.setAttribute('aria-expanded', String(show)); });
    window.addEventListener('resize', function() { if (window.innerWidth > 768) { filterBar.hidden = false; filterToggle.setAttribute('aria-expanded', 'true'); } });
  }

  var savedOpen = [], savedTheme = null;
  function beforePrint() { savedOpen = []; savedTheme = h.getAttribute('data-theme'); h.removeAttribute('data-theme'); [].slice.call(document.querySelectorAll('details')).forEach(function(d) { savedOpen.push({el: d, was: d.open}); d.open = true; }); }
  function afterprint() { savedOpen.forEach(function(s) { s.el.open = s.was; }); savedOpen = []; if (savedTheme) h.setAttribute('data-theme', savedTheme); savedTheme = null; }
  window.addEventListener('beforeprint', beforePrint);
  window.addEventListener('afterprint', afterprint);
  if (window.matchMedia) { var mql = window.matchMedia('print'); if (mql.addEventListener) mql.addEventListener('change', function(e) { if (e.matches) beforePrint(); else afterprint(); }); }

  applyFilters();
})();
