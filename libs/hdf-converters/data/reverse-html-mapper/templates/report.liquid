{% comment %}Root report template. Captures body content then includes the html.liquid shell.
Variables: All IOutputData fields + site (title, inline_styles, inline_scripts).
Follows the Blades starter pattern: {% capture body %}...{% endcapture %} then {% include 'html' %}.{% endcomment -%}
{%- capture body -%}
  <a class="skip-link" href="#main">Skip to report content</a>

  <header class="container-fluid no-print">
    <hgroup>
      <h1>Heimdall {{ exportType }} Report</h1>
      <p>Self-contained security compliance report</p>
    </hgroup>
  </header>

  <nav class="container-fluid no-print" aria-label="Report contents">
    <ul>
      <li><a href="#summary"><strong>Summary</strong></a></li>
      <li><a href="#profile-info">Profile Info</a></li>
      {%- if showResultSets %}
      {%- for resultSet in resultSets %}
      <li><a href="#file-{{ resultSet.fileID }}">{{ resultSet.filename }}</a></li>
      {%- endfor %}
      {%- endif %}
    </ul>
    <ul>
      {%- if showResultSets %}
      <li><input type="search" id="control-search" placeholder="Search controls..." aria-label="Search controls by ID or title" style="width:14rem;margin:0;"></li>
      <li><button type="button" id="btn-expand-all">Expand All</button></li>
      <li><button type="button" id="btn-collapse-all">Collapse All</button></li>
      <li><button type="button" id="btn-clear-filters" class="secondary">Clear Filters</button></li>
      {%- endif %}
      <li><button type="button" id="theme-toggle" class="contrast" aria-label="Toggle light/dark theme">&#9788;/&#9790;</button></li>
    </ul>
  </nav>

  {% render 'partials/filter-bar', statistics: statistics, showResultSets: showResultSets %}

  <main id="main" class="container-fluid">
    {% render 'partials/summary', statistics: statistics, severity: severity, compliance: compliance, icons: icons %}
    {% render 'partials/profile-info', files: files %}

    {%- if showResultSets %}
    {%- for resultSet in resultSets %}
    <section id="file-{{ resultSet.fileID }}" aria-labelledby="file-{{ resultSet.fileID }}-h">
      <h2 id="file-{{ resultSet.fileID }}-h">{{ resultSet.filename }}</h2>
      {%- for result in resultSet.results %}
      {% render 'partials/control-card', result: result, showCode: showCode %}
      {%- endfor %}
    </section>
    {%- endfor %}
    {%- endif %}
  </main>

  <footer class="container-fluid">
    <p><small>Generated by Heimdall &middot; {{ exportType }} Report &middot; Self-contained export</small></p>
  </footer>
{%- endcapture -%}
{% include 'html' %}
