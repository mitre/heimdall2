+			}
+			r.Env.(*FakeEnvManager).Env["HEIMDALL_TLS_CERT_DAYS"] = "14"
+			cmd := NewSetupCmd(r)
+			cmd.SetArgs(append([]string{"--interactive", "--reconfigure"}, tc.args...))
+			require.NoError(t, cmd.Execute())
