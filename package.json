{
  "name": "root",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "description": "Heimdall monorepo — security results viewer (server and lite), OHDF converters, and InSpecJS",
  "workspaces": [
    "apps/*",
    "libs/*",
    "test"
  ],
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/mitre/heimdall2"
  },
  "scripts": {
    "backend": "yarn workspace heimdall-server",
    "build": "lerna run build",
    "common": "yarn workspace @heimdall/common",
    "cypress-test": "yarn workspace @heimdall/cypress-tests",
    "frontend": "yarn workspace @mitre/heimdall-lite",
    "hdf-converters": "yarn workspace @mitre/hdf-converters",
    "inspecjs": "yarn workspace inspecjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --fix --fix-type layout",
    "lint:check": "eslint",
    "lint:ci": "eslint --max-warnings 0",
    "lint:fix:unsafe": "eslint --fix",
    "pack:all": "lerna exec yarn pack --scope inspecjs --scope @mitre/heimdall-lite --scope @mitre/hdf-converters --parallel",
    "start": "yarn backend start",
    "start:built": "yarn build && yarn backend start",
    "start:dev": "lerna run start:dev --parallel --stream",
    "test:ui": "cypress run",
    "test:ui:open": "cypress open"
  },
  "dependencies": {
    "lerna": "^9.0.0",
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "@e18e/eslint-plugin": "^0.5.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.1",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.0",
    "@eslint/markdown": "^8.0.1",
    "@stylistic/eslint-plugin": "^5.9.0",
    "@vitest/eslint-plugin": "^1.6.14",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-cypress": "^6.3.0",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-markdown-links": "^0.9.0",
    "eslint-plugin-markdown-preferences": "^0.41.1",
    "eslint-plugin-n": "^18.0.1",
    "eslint-plugin-perfectionist": "^5.8.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-regexp": "^3.1.0",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-unicorn": "^68.0.0",
    "eslint-plugin-vue": "^10.8.0",
    "eslint-plugin-yml": "^3.3.1",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.56.1",
    "vue-eslint-parser": "^10.4.0"
  },
  "resolutions": {
    "fast-glob": "3.3.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
